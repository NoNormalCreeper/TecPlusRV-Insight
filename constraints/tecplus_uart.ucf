# TEC-PLUS UART 探针约束草案。
# 对应顶层：rtl/probe/probe_uart_top.v。
# 只覆盖 Probe 1 需要的 clk/reset/UART TX/RX。
# 如果实验室现象异常，请先核对真实教学板卡和 UCF，
# 不要直接认定 RTL 有问题。

NET "clk"      LOC = "T8" | IOSTANDARD = "LVCMOS33";
NET "reset"    LOC = "L3" | IOSTANDARD = "LVCMOS33";
NET "clk" TNM_NET = "clk_grp";
TIMESPEC "TS_clk_grp" = PERIOD "clk_grp" 20 ns HIGH 50%;
NET "uart_txd" LOC = "D6" | IOSTANDARD = "LVCMOS33";
NET "uart_rxd" LOC = "D5" | IOSTANDARD = "LVCMOS33";
